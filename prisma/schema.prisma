generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Contact form submissions
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  formType  String   @default("contact") // contact, prayer_request, general
  status    String   @default("new") // new, read, responded
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_submissions")
}

// Newsletter subscriptions
model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  status    String   @default("active") // active, unsubscribed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscriptions")
}

// Member information requests
model MemberInquiry {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String?
  address       String?
  inquiryType   String   @default("membership") // membership, visit, baptism, counseling
  previousChurch String?
  message       String?
  status        String   @default("new") // new, contacted, scheduled, completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("member_inquiries")
}

// Prayer requests
model PrayerRequest {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  request   String
  isPublic  Boolean  @default(false) // whether to share in church
  status    String   @default("active") // active, answered, archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prayer_requests")
}

// Events (for future expansion)
model Event {
  id           String   @id @default(cuid())
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime?
  location     String?
  imageUrl     String?
  category     String   @default("service") // service, fellowship, outreach, special
  isActive     Boolean  @default(true)
  showInSlider Boolean  @default(false) // whether to show in featured events slider
  archived     Boolean  @default(false) // whether event is archived (past end date)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("events")
}

// Site content (for dynamic content management)
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // homepage_welcome, history_text, etc.
  title     String?
  content   String
  type      String   @default("text") // text, html, markdown
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

// NextAuth models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("user") // user, admin
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Sermons
model Sermon {
  id            String   @id @default(cuid())
  title         String
  description   String?
  pastor        String   @default("Dr. Mancil Carroll III")
  date          DateTime
  scripture     String?
  audioUrl      String?
  videoUrl      String?
  thumbnailUrl  String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sermons")
}

// Pictures/Gallery
model Picture {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String   @default("general") // general, events, ministry, building
  eventId     String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pictures")
}

// Staff members
model Staff {
  id          String   @id @default(cuid())
  name        String
  title       String
  bio         String?
  imageUrl    String?
  email       String?
  phone       String?
  order       Int      @default(0) // for display ordering
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("staff")
}
